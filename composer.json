{
    "name": "ernestdefoe/marquee",
    "description": "Link discussions to movies, TV shows and games, and show them in the discussion hero.",
    "type": "flarum-extension",
    "license": "MIT",
    "version": "0.0.1",
    "authors": [{ "name": "Ernest Defoe", "email": "ernestdefoe@gmail.com" }],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "extra": {
        "flarum-extension": {
            "title": "Marquee (prototype)",
            "category": "feature",
            "optional-dependencies": ["flarum/tags"],
            "icon": { "name": "fas fa-film", "backgroundColor": "#0d253f", "color": "#01b4e4" }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
